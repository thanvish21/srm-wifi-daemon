[Unit]
Description=SRMIST WiFi Auto-Reconnect & 24h Watchdog Daemon
Documentation=https://github.com/thanvish21/srm-wifi-daemon
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/thanvish/srm-wifi-daemon/src/srm_wifi.py --daemon
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
